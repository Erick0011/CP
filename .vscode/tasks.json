{
    "version": "2.0.0",
    "tasks": [
        {
            // Ctrl+Shift+B: compila com sanitizers (acha overflow, índice fora do vetor) e lê entrada de input.txt
            "label": "CP: rodar com debug + input.txt",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/run.sh \"${file}\" \"${workspaceFolder}/input.txt\"",
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "clear": true },
            "problemMatcher": ["$gcc"]
        }
    ]
}
